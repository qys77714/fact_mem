# ============================================================
# easy-mem 环境变量配置
# 复制此文件为 .env：cp .env.example .env
# 然后根据实际部署修改各变量的值。
# ============================================================

# ---- 本地 VLLM 模型服务 ----
VLLM_API_KEY=zjj                         # 本地 vllm 的 API key（与启动脚本 --api-key 一致）
VLLM_BASE_URL=http://localhost:8000/v1/   # 默认 vllm 地址（单模型时使用）

# 多模型端口映射（端口号与启动脚本中 --port 一致）
# 命名规则：PORT_{模型别名大写，-变_} = 端口号
# 例：gemma4-26B → PORT_GEMMA4_26B
PORT_GEMMA4_26B=7111
PORT_GEMMA4_12B=7112
PORT_GEMMA4_E4B=7115
PORT_QWEN3_4B=7114
PORT_QWEN3_8B=7113
PORT_QWEN3_32B=7111        # 可与 gemma4-26B 共用端口（同一 vllm 实例服务多个模型）
PORT_QWEN3_5_4B=7114
PORT_QWEN3_5_9B=7113

# ---- Embedding 服务 ----
EMBEDDING_BASE_URL=http://localhost:7110/v1/
EMBEDDING_API_KEY=zjj
# EMBEDDING_MODEL=qwen3-embedding-0.6b   # 默认值，一般不需要改

# ---- 云端模型 API（Judge / 备用答题） ----

# 阿里云 DashScope（qwen3-max、qwen-plus 等）
DASHSCOPE_API_KEY=your_dashscope_key_here
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# OpenAI / Azure（gpt-4o-mini 等 Judge 模型）
OPENAI_API_KEY=your_openai_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek（deepseek-v3 等）
# DEEPSEEK_API_KEY=your_deepseek_key_here

# 零一万物（yi-large 等）
# YI_API_KEY=your_yi_key_here

# 书生浦语（internlm2_5 等）
# INTERN_API_KEY=your_intern_key_here
